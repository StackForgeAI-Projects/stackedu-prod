# Rwanda (stackedu.rw) — Resend account where stackedu.rw is verified
RESEND_API_KEY_RW=re_xxxxxxxx
CONTACT_FROM_EMAIL_RW=StackEDU <hello@stackedu.rw>

# Africa (stackedu.africa) — Resend account where stackedu.africa is verified
RESEND_API_KEY_AFRICA=re_xxxxxxxx
CONTACT_FROM_EMAIL_AFRICA=StackEDU <hello@stackedu.africa>

# Inbox for demo and partner submissions (one per market)
CONTACT_TO_EMAIL_RW=your-rw-inbox@example.com
CONTACT_TO_EMAIL_AFRICA=your-africa-inbox@example.com

# Optional legacy names (local dev / single-market fallback)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=StackEDU <hello@stackedu.africa>

# EMS app origin. Portal paths on this marketing site redirect here.
# Local default is http://localhost:3001 when EMS web is not on :3000.
# EMS_APP_URL=http://localhost:3001

# Cloudinary (public values only — never put API secret in NEXT_PUBLIC_*)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_HERO_VIDEO_ID=StackEDU_Demo_english_xuwkyz
NEXT_PUBLIC_HERO_VIDEO_URL_FR=https://res.cloudinary.com/iikwn37o/video/upload/v1786066360/StackEDU_Demo_French_tnqdsv.mp4
NEXT_PUBLIC_HERO_VIDEO_URL_RW=https://res.cloudinary.com/iikwn37o/video/upload/v1786121432/StackEDU_Demo_Kiyarwanda_kc4dxk.mp4
# Optional French public ID instead of full URL
# NEXT_PUBLIC_HERO_VIDEO_ID_FR=StackEDU_Demo_French_tnqdsv
# Optional Kinyarwanda public ID instead of full URL
# NEXT_PUBLIC_HERO_VIDEO_ID_RW=StackEDU_Demo_Kiyarwanda_kc4dxk
# Optional: full delivery URL instead of cloud name + public ID
# NEXT_PUBLIC_HERO_VIDEO_URL=https://res.cloudinary.com/your_cloud_name/video/upload/.../demo.mp4
