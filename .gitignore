# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design reference (Lovable export — not part of production site)
/stackedu-design/
/stackforgenext-main/

# Development-only paths. Tracked on `development` with `git add -f`.
# Never present on `main` (production).
/docs/
/ems/docs/
/ems/context/
/ems/design_system/
/ems/EMS-master-context.md
/stackedu-app-frontend-design/
/code-standards.md

# EMS monorepo — secrets and local artifacts (also covered by ems/.gitignore)
/ems/.env
/ems/.env.local
/ems/.data/
/ems/node_modules/
/ems/**/node_modules/
/ems/**/dist/
/ems/**/.turbo/

# editor / IDE
.cursor/
.vscode/
.idea/

# OS
Thumbs.db

# Office lock files
~\$*

