# Copy to .env and adjust. Never commit the real .env.
# The API reads these; the web app reads apps/web/.env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────
# Local development uses the Postgres container from docker-compose.yml, which
# publishes on 5433 so it cannot clash with a Postgres already installed on the
# machine.
PLATFORM_DATABASE_URL=postgres://stackedu:stackedu@localhost:5433/stackedu_platform

# Used only to CREATE DATABASE when provisioning an institution. Defaults to
# PLATFORM_DATABASE_URL, which is correct when every database is on one server.
# ADMIN_DATABASE_URL=

# Connection pools are held per institution, so each one stays small.
DB_POOL_MAX_CONNECTIONS=5
DB_POOL_IDLE_TIMEOUT_SECONDS=300

# ── Cross-origin setup ────────────────────────────────────────────────────
# The web app and the API are on different hosts, so the API must name every
# origin allowed to call it. A wildcard is rejected because cookies are sent.
ALLOWED_ORIGINS=http://localhost:3000,https://app.stackedu.rw,https://app.stackedu.africa

# Parent domain for the session cookie. The leading dot shares it between
# app.stackedu.rw and api.stackedu.rw. Required in production.
# COOKIE_DOMAIN=.stackedu.rw

# Public URL of this API (used for local signed upload/download links).
API_PUBLIC_URL=http://localhost:8080

# File storage for application documents.
# local = disk under STORAGE_LOCAL_ROOT (development)
# r2    = Cloudflare R2 (production) — set the R2_* variables below
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/uploads
# STORAGE_SIGNING_SECRET=replace-with-a-long-random-string

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=stackedu-uploads

# Application fee (RWF) and payment behaviour.
# sandbox = MoMo/Airtel/Card complete immediately (local/dev)
# live    = Pending until gateway webhook or staff confirms bank transfer
APPLICATION_FEE_RWF=10000
PAYMENT_MODE=sandbox

# Payment gateways (ICT enables integrations and can paste keys there; env is the fallback).
# PAWAPAY_API_TOKEN=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=

# SMS (Twilio — optional until going live; ICT can paste these under Integrations).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Transactional email (admissions submit + decision). Optional locally.
# ICT can paste the key under Integrations. The institution logo and colour
# from System Settings are applied to these emails.
# RESEND_API_KEY=re_...
# EMAIL_FROM=StackEDU Admissions <admissions@stackedu.rw>
# EMAIL_REPLY_TO=admissions@stackedu.rw
# WEB_APP_URL=https://app.stackedu.rw

# Live classroom (LiveKit Cloud or any LiveKit-compatible URL).
# ICT can also paste these under Integrations. Stored keys override env.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Whiteboard sync (Hocuspocus). Leave unset to save scenes through the API only.
# HOCUSPOCUS_URL=ws://localhost:8081
# COLLAB_PORT=8081
# COLLAB_SECRET=replace-with-a-long-random-string

# AI vendors (optional). ICT can also paste a key under Integrations.
# When unset, the in-built generator is used and never waits on a vendor.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=
