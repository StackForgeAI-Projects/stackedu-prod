{
  "name": "@stackedu/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "collab": "tsx src/collab.ts",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle/platform.config.ts && drizzle-kit generate --config=drizzle/institution.config.ts",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "institution:create": "tsx src/db/cli/create-institution.ts",
    "purge-applicants": "tsx src/db/cli/purge-applicants.ts",
    "db:seed-applicant-demo": "tsx src/db/cli/seed-applicant-demo.ts",
    "reverse-admission": "tsx src/db/cli/reverse-admission-acceptance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@hocuspocus/server": "^4.7.0",
    "@hono/node-server": "^1.14",
    "@stackedu/shared": "workspace:*",
    "drizzle-orm": "^0.44",
    "hono": "^4",
    "livekit-server-sdk": "^2.19.0",
    "otplib": "^13.4.1",
    "postgres": "^3.4",
    "qrcode": "^1.5.4",
    "resend": "^6.20.0",
    "yjs": "^13.6.32",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.8",
    "vitest": "^3"
  }
}
