# Copy to .env.local for local development.
# Only variables prefixed with VITE_ are exposed to the browser — never put a
# secret in this file, because everything here ships in the JavaScript bundle.

# Where the API lives.
#   local:      http://localhost:8080
#   production: https://api.stackedu.rw   (used by both app.stackedu.rw and
#                                          app.stackedu.africa)
VITE_API_URL=http://localhost:8080

# Whiteboard sync. Leave unset to save the board through the API only.
# VITE_HOCUSPOCUS_URL=ws://localhost:8081
